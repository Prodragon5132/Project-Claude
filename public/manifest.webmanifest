{
  "name": "SafePaste — redact before you paste",
  "short_name": "SafePaste",
  "description": "Strip personal data out of anything before you paste it into an AI. Runs entirely in your browser.",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "background_color": "#fbfbfd",
  "theme_color": "#3448d0",
